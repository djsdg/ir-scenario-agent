# Required for live calls. Do not commit the real key.
OPENAI_API_KEY=your-openai-key

# The default is a current GPT-5 family model; override per account/project.
OPENAI_MODEL=gpt-5.5

# Generic provider settings. IR_AGENT_* takes precedence over OPENAI_*.
# For DeepSeek use:
# IR_AGENT_API_KEY=your-deepseek-key
# IR_AGENT_API_MODE=chat_completions
# IR_AGENT_BASE_URL=https://api.deepseek.com
# IR_AGENT_MODEL=deepseek-v4-pro
# IR_AGENT_API_MODE supports: responses, chat_completions
# IR_AGENT_API_KEY=
# IR_AGENT_BASE_URL=
# IR_AGENT_MODEL=

# Optional OpenAI endpoint settings.
# OPENAI_BASE_URL=
# OPENAI_ORG_ID=

# Local project settings.
IR_AGENT_LIBRARY_PATH=data/scenario_library.json
# 也可以将 IR_AGENT_LIBRARY_PATH 指向目录，自动使用
# <目录>/scenarios.json 和 <目录>/uc/use_cases.json。
# IR_AGENT_LIBRARY_PATH=data/scene_library
# IR_AGENT_UC_LIBRARY_PATH=data/scene_library/uc/use_cases.json
IR_AGENT_SPEC_PATH=config/ir_sc_uc_spec.json
IR_AGENT_SESSION_DIR=data/sessions
IR_AGENT_OUTPUT_DIR=data/outputs
IR_AGENT_MEMORY_PATH=data/memory.sqlite3
IR_AGENT_SKILLS_DIR=skills
IR_AGENT_PLUGINS_DIR=plugins
IR_AGENT_MCP_CONFIG=config/mcp.json
IR_AGENT_USER_ID=default
IR_AGENT_MAX_TOOL_ROUNDS=8
IR_AGENT_REQUEST_TIMEOUT=120
IR_AGENT_MAX_RETRIES=2
IR_AGENT_RETRY_BACKOFF=0.5
IR_AGENT_MAX_SESSION_ITEMS=100
IR_AGENT_MAX_CONTEXT_CHARS=120000
IR_AGENT_STRUCTURED_OUTPUT=true
IR_AGENT_REQUIRE_TOOL_APPROVAL=true
IR_AGENT_AUDIT_PATH=data/audit.jsonl
