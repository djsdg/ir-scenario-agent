  "requirements": [
    {
      "code": "IR-XXXX-001",
      "title": "【DFX】某指令异常检测机制改进",
      "description": "系统正常运行时，某部件出现异常并导致关键进程反复复位、校验错误或数据不一致。系统需要依据故障表现检测异常，对明确异常执行复位修复或下电隔离，对反复进程复位在排除软件干扰后修复或恢复节点。",
      "source": "项目与提出人（已脱敏）",
      "owner": null,
      "who": "本系统",
      "when": "系统正常运行时，某部件出现异常",
      "where": "系统的某部件",
      "what": "改进某指令异常检测机制",
      "how": [
        "根据反复复位、校验错误或数据不一致等故障表现检测异常",
        "对明确异常执行复位修复或下电隔离",
        "对反复进程复位在排除软件异常干扰后修复或恢复节点",
        "仅监控 IO 进程异常"
      ],
      "why": "当前检测机制不能有效检测全部异常，可能导致关键进程反复复位或数据不一致",
      "how_much": [
        "非明确异常一个月只处理一个节点",
        "检测能力提升",
        "检测到异常后产生告警",
        "检测阈值可调整",
        "对性能无影响"
      ],
      "constraints": [
        "进程异常只监控 IO 进程",
        "检测为事后检测，不能保证数据不损坏",
        "数据修复不在本 IR 范围",
        "根据复位表现判断可能误判并提高器件故障率"
      ],
      "performance": "对性能无影响",
      "reliability": "检测能力提升",
      "serviceability": "检测到异常后产生告警",
      "maintainability": "检测阈值可以调整",
      "sales": "不涉及",
      "delivery_time": null,
      "tags": [
        "DFX",
        "异常检测",
        "故障隔离",
        "IO进程"
      ],
      "id": "IR-XXXX-001",
      "created_at": "2026-08-21T00:00:00Z",
      "updated_at": "2026-08-21T00:00:00Z"
    },
    {
      "code": "IR-TEST-001",
      "title": "【DFX】单节点 IO 进程反复复位异常检测与隔离改进",
      "description": "系统正常运行时，类型 A 部件可能出现异常，导致单节点 IO 进程反复 core 或复位，也可能出现校验错误和数据不一致。现有检测机制不能覆盖全部异常，需要根据故障表现识别异常，并在确认后对节点执行复位修复、恢复或下电隔离，同时产生告警。",
      "source": "测试项目与提出人（脱敏）",
      "owner": "脱敏责任人",
      "who": "本系统",
      "when": "系统正常运行时，目标部件出现异常；单节点 IO 进程在观察窗口内反复 core 或复位。",
      "where": "系统中的类型 A 部件及其所在节点，重点关注 IO 进程。",
      "what": "改进单节点 IO 进程反复 core 或复位的异常检测、节点修复和隔离机制。",
      "how": [
        "采集单节点 IO 进程的 core、复位、校验错误和数据不一致等故障表现。",
        "根据可配置阈值判断是否达到异常检测条件。",
        "对明确的异常执行复位修复或下电隔离，并记录处理结果。",
        "对反复 core 或复位的节点先排除软件异常干扰，再执行恢复、修复或隔离。",
        "检测到异常后产生告警，并保留诊断信息。",
        "仅对 IO 进程进行监控。"
      ],
      "why": "当前检测机制无法有效检测所有部件异常，可能导致关键进程反复复位、节点持续异常或数据不一致，影响系统故障发现和服务恢复。",
      "how_much": [
        "非明确异常每月最多处理一个节点。",
        "提升异常检测能力。",
        "检测到异常后必须产生告警。",
        "检测阈值支持调整。",
        "对系统性能无明显影响。"
      ],
      "constraints": [
        "只监控 IO 进程，不扩大到其他进程。",
        "只针对类型 A 部件。",
        "检测属于事后检测，不能保证数据不损坏。",
        "数据修复不属于本 IR 范围。",
        "根据进程复位表现判断异常可能存在误判，器件故障率可能上升。",
        "软件异常未排除前，不应直接执行节点隔离。"
      ],
      "performance": "对性能无明显影响。",
      "reliability": "提升异常检测和故障隔离能力。",
      "serviceability": "检测到异常后产生告警并保留诊断信息。",
      "maintainability": "检测阈值支持调整。",
      "sales": "不涉及。",
      "delivery_time": "待项目计划确定。",
      "tags": [
        "DFX",
        "IO 进程",
        "反复 core",
        "异常检测",
        "故障隔离",
        "类型 A",
        "正常服务"
      ],
      "id": "IR-TEST-001",
      "created_at": "2026-08-24T01:43:39.607918Z",
      "updated_at": "2026-08-24T01:43:39.607918Z"
    }
